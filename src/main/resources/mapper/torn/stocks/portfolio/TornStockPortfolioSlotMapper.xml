<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.TornStockPortfolioSlotMapper">
    <!-- 查询指定组合的全部仓位槽位 -->
    <select id="selectAllByPortfolioCode" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockPortfolioSlotDO">
        SELECT * FROM torn_stock_portfolio_slot
        WHERE portfolio_code = #{portfolioCode}
          AND deleted = 0
        ORDER BY slot_no ASC
    </select>
</mapper>
