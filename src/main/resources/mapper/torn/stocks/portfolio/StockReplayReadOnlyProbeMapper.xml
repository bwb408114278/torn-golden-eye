<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.StockReplayReadOnlyProbeMapper">

    <!-- 当前会话事务只读标志: on=只读, off=可写 -->
    <select id="selectTransactionReadOnly" resultType="string">
        SELECT current_setting('transaction_read_only')
    </select>

    <!-- 当前会话事务隔离级别: 回放要求 repeatable read -->
    <select id="selectTransactionIsolationLevel" resultType="string">
        SELECT current_setting('transaction_isolation')
    </select>

</mapper>
