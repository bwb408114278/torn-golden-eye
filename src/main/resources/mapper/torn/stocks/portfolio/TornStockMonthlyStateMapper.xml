<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.TornStockMonthlyStateMapper">
    <!-- 查询指定月份已确认的月度状态 -->
    <select id="selectConfirmedByMonth" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockMonthlyStateDO">
        SELECT * FROM torn_stock_monthly_state
        WHERE effective_month = #{effectiveMonth}
          AND state_status = 'CONFIRMED'
          AND deleted = 0
    </select>
</mapper>
