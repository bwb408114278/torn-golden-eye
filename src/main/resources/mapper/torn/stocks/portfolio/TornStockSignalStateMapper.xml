<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.TornStockSignalStateMapper">
    <!-- 查询全部信号状态 -->
    <select id="selectAll" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockSignalStateDO">
        SELECT * FROM torn_stock_signal_state
        WHERE deleted = 0
    </select>

    <!-- 按股票ID列表和买入规则版本批量查询信号状态 -->
    <select id="selectByStocksIdsAndVersion" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockSignalStateDO">
        SELECT * FROM torn_stock_signal_state
        WHERE deleted = 0
          AND buy_rule_version = #{buyRuleVersion}
          AND stocks_id IN
        <foreach collection="stocksIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
