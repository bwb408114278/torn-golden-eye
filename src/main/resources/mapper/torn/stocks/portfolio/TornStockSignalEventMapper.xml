<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.TornStockSignalEventMapper">
    <!-- 按轮次时间批量查询全部信号事件 -->
    <select id="selectByRoundTime" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockSignalEventDO">
        SELECT * FROM torn_stock_signal_event
        WHERE round_time = #{roundTime}
          AND deleted = 0
    </select>
</mapper>
