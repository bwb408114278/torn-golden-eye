<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pn.torn.goldeneye.repository.mapper.torn.stocks.portfolio.TornStockNoticeAuditMapper">
    <!-- 查询待发送通知 -->
    <select id="selectPendingNotices" resultType="pn.torn.goldeneye.repository.model.torn.stocks.portfolio.TornStockNoticeAuditDO">
        SELECT * FROM torn_stock_notice_audit
        WHERE send_status = 'PENDING'
          AND deleted = 0
    </select>
</mapper>
